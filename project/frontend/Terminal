  let currentLevel = null;   // bak, mag, asp, spo
  let previousScreen = "screen-main";
  let lastFaculty = null;
  let lastFacultyFull = null;

  //Навигация 

  function goToScreen(id) {
    document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
    document.getElementById(id).classList.add("active");
  }

  function openFacultyGrid(level) {
    currentLevel = level;
    previousScreen = "screen-doc-level";
    const conf = facultyData[level];

    document.getElementById("faculties-title").textContent = conf.title;
    document.getElementById("faculties-subtitle").textContent = conf.subtitle;

    const grid = document.getElementById("faculties-grid");
    grid.innerHTML = "";

    conf.faculties.forEach(f => {
      const div = document.createElement("div");
      div.className = "card";
      div.innerHTML = `
        <div class="card-emoji">${f.icon}</div>
        <div class="card-code">${f.code}</div>
        <div class="card-name">${f.full}</div>
      `;
      div.onclick = () => openPrograms(level, f.code, f.full);
      grid.appendChild(div);
    });

    goToScreen("screen-faculties");
  }

  function goBackFromFaculties() {
    goToScreen(previousScreen || "screen-doc-level");
  }

  function openPrograms(level, facultyCode, facultyFullName) {
    lastFaculty = facultyCode;
    lastFacultyFull = facultyFullName;

    const list = document.getElementById("programs-list");
    list.innerHTML = "";

    const arr = (programsData[level] && programsData[level][facultyCode]) || [];

    if (arr.length === 0) {
      const p = document.createElement("p");
      p.textContent = "Список программ уточняйте в приёмной комиссии данного факультета.";
      p.style.textAlign = "center";
      p.style.color = "#666";
      list.appendChild(p);
    } else {
      arr.forEach(prog => {
        const btn = document.createElement("button");
        btn.className = "list-item";
        btn.textContent = prog;
        btn.onclick = () => createDocTicket(level, facultyCode, facultyFullName, prog);
        list.appendChild(btn);
      });
    }

    const levelText = {
      bak: "Бакалавриат / специалитет",
      mag: "Магистратура",
      asp: "Аспирантура / ординатура",
      spo: "Колледж (СПО)"
    }[level];

    document.getElementById("programs-title").textContent = "Направления подготовки";
    document.getElementById("programs-subtitle").textContent =
      `${levelText}. Факультет: ${facultyCode} — ${facultyFullName}`;

    previousScreen = "screen-faculties";
    goToScreen("screen-programs");
  }

  function goBackFromPrograms() {
    goToScreen("screen-faculties");
  }

  // ---------- Генерация талонов ----------

  function randomTicketNumber(prefix) {
    const n = Math.floor(100 + Math.random() * 900);
    return `Талон № ${prefix}-${n}`;
  }

  function createDocTicket(level, facultyCode, facultyFullName, program) {
    const prefixMap = { bak: "БАК", mag: "МАГ", asp: "АСП", spo: "СПО" };
    document.getElementById("ticket-number").textContent =
      randomTicketNumber(prefixMap[level] || "DOC");

    document.getElementById("ticket-main-text").textContent = program;
    const levelText = {
      bak: "Бакалавриат / специалитет",
      mag: "Магистратура",
      asp: "Аспирантура / ординатура",
      spo: "Колледж (СПО)"
    }[level];

    document.getElementById("ticket-sub-text").textContent =
      `${levelText}. Факультет: ${facultyCode} — ${facultyFullName}`;

    goToScreen("screen-ticket");
  }

  function createConsultTicket(serviceName) {
    document.getElementById("ticket-number").textContent =
      randomTicketNumber("КОН");

    document.getElementById("ticket-main-text").textContent = serviceName;
    document.getElementById("ticket-sub-text").textContent =
      "Тип услуги: консультация";

    goToScreen("screen-ticket");
  }

  function createOperatorTicket(name, role, rating) {
    document.getElementById("ticket-number").textContent =
      randomTicketNumber("ОП");

    document.getElementById("ticket-main-text").textContent =
      `Оператор: ${name}`;
    document.getElementById("ticket-sub-text").textContent =
      `${role} · рейтинг ${rating.toFixed(1)}`;

    goToScreen("screen-ticket");
  }
