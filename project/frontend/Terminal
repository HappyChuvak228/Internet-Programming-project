<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>Электронная очередь</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background: #f5f5f7;
      color: #222;
      min-height: 100vh;
      display: flex;
      align-items: stretch;
      justify-content: center;
    }

    .app {
      width: 100%;
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .screen {
      display: none;
      text-align: center;
    }

    .screen.active {
      display: block;
    }

    h1 {
      font-size: 26px;
      letter-spacing: 0.06em;
      color: #4a6bff;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    h2 {
      font-size: 22px;
      margin-bottom: 6px;
      color: #333;
    }

    .subtitle {
      font-size: 16px;
      color: #777;
      margin-bottom: 26px;
    }

    .big-buttons {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .big-button {
      background: #020213;
      color: #fff;
      border-radius: 16px;
      padding: 22px 40px;
      font-size: 18px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: none;
      cursor: pointer;
      box-shadow: 0 18px 28px rgba(0, 0, 0, 0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    }

    .big-button span.emoji {
      font-size: 22px;
    }

    .big-button:hover {
      background: #05052a;
      transform: translateY(-2px);
      box-shadow: 0 22px 32px rgba(0, 0, 0, 0.22);
    }

    .big-button:active {
      transform: translateY(0);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 14px;
      color: #777;
      margin-bottom: 20px;
      cursor: pointer;
      user-select: none;
    }

    .back-link span {
      font-size: 18px;
    }

    .grid {
      max-width: 820px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 22px;
      justify-items: center;
    }

    .card {
      width: 190px;
      height: 190px;
      background: #ffffff;
      border-radius: 18px;
      border: 1px solid #ececec;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      box-shadow: 0 18px 26px rgba(0, 0, 0, 0.06);
      transition: box-shadow 0.12s ease, transform 0.12s ease, border-color 0.12s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      border-color: #d0d0ff;
      box-shadow: 0 22px 32px rgba(20, 20, 60, 0.18);
    }

    .card-emoji {
      font-size: 34px;
      margin-bottom: 6px;
    }

    .card-code {
      font-size: 17px;
      font-weight: 600;
      color: #333;
    }

    .card-name {
      font-size: 13px;
      color: #999;
      max-width: 150px;
    }

    .list {
      max-width: 850px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .list-item {
      background: #020213;
      color: #fff;
      border-radius: 12px;
      padding: 18px 28px;
      text-align: left;
      border: none;
      cursor: pointer;
      font-size: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 16px 24px rgba(0, 0, 0, 0.18);
      transition: background 0.12s ease, transform 0.12s ease, box-shadow 0.12s ease;
    }

    .list-item:hover {
      background: #05052a;
      transform: translateY(-2px);
      box-shadow: 0 22px 32px rgba(0, 0, 0, 0.22);
    }

    .code-tag {
      font-size: 14px;
      opacity: 0.85;
    }

    /* Ticket */

    .ticket-wrapper {
      max-width: 620px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 22px;
      padding: 40px 40px 32px;
      box-shadow: 0 24px 40px rgba(0, 0, 0, 0.12);
    }

    .ticket-number {
      font-size: 22px;
      color: #4a6bff;
      margin-bottom: 20px;
    }

    .qr-placeholder {
      width: 210px;
      height: 210px;
      border-radius: 18px;
      border: 2px dashed #d7d7d7;
      margin: 0 auto 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 42px;
      color: #222;
      background: #fafafa;
    }

    .ticket-main {
      font-size: 16px;
      margin-bottom: 6px;
    }

    .ticket-sub {
      font-size: 15px;
      color: #666;
      margin-bottom: 26px;
    }

    .ticket-divider {
      height: 1px;
      background: #eee;
      margin: 16px 0 26px;
    }

    .primary-button {
      margin-top: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 16px 32px;
      background: #020213;
      color: #fff;
      border-radius: 14px;
      border: none;
      cursor: pointer;
      font-size: 16px;
      box-shadow: 0 18px 26px rgba(0, 0, 0, 0.18);
      transition: background 0.12s ease, transform 0.12s ease, box-shadow 0.12s ease;
    }

    .primary-button:hover {
      background: #05052a;
      transform: translateY(-2px);
      box-shadow: 0 24px 34px rgba(0, 0, 0, 0.22);
    }

    .primary-button:active {
      transform: translateY(0);
      box-shadow: 0 10px 18px rgba(0, 0, 0, 0.18);
    }

    .lock-emoji {
      font-size: 18px;
    }

    @media (max-width: 720px) {
      .ticket-wrapper {
        padding: 30px 20px 24px;
      }
      .card {
        width: 150px;
        height: 160px;
      }
      .app {
        margin-top: 20px;
      }
    }
  </style>
</head>
